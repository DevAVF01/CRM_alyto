PORT=4000
NODE_ENV=development
LOG_LEVEL=info
APP_VERSION=1.0.0

# Supabase (dejar vacío para operar con el almacén demo del ECP)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Firebase Admin (opcional, para notificaciones push FCM)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Sentry (opcional)
SENTRY_DSN=

# Conectores MCP
MCP_STELLAR_URL=http://localhost:4601
MCP_KYC_URL=http://localhost:4602
MCP_NOTIFICATIONS_URL=http://localhost:4603

# Claves VAPID del ECP (generar con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Secreto demo para tokens del ECP (cambiar en despliegues)
DEMO_AUTH_SECRET=ecp-demo
