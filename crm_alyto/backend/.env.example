PORT=4000
NODE_ENV=development
LOG_LEVEL=info
APP_VERSION=1.0.0

# Supabase. Si estas dos variables quedan vacias el backend NO arranca,
# a menos que DEMO_MODE=true este activo de forma explicita.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Modo demostracion del ECP. Con true el CRM lee del almacen en memoria
# y avisa en el log y en cada pantalla. Con false no se sirve dato de demostracion alguno.
DEMO_MODE=true

# Firma de sesiones del modo demostracion. Obligatorio y largo (minimo 32 caracteres).
# Generar uno con: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Contrasena unica de las cuentas de demostracion (minimo 8 caracteres).
# Los correos validos estan en backend/src/data/demoAccounts.js. Ningun otro correo entra.
DEMO_PASSWORD=

# Firebase Admin (opcional, para notificaciones push FCM)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Sentry (opcional)
SENTRY_DSN=

# Conectores MCP
MCP_STELLAR_URL=http://localhost:4601
MCP_KYC_URL=http://localhost:4602
MCP_NOTIFICATIONS_URL=http://localhost:4603

# Claves VAPID del ECP (generar con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
